      ],
      "construes": [
        "ni:sec_138"
      ],
      "holding": "Part-payments made after issuance but before encashment must be endorsed (s.56); dishonour of the unendorsed cheque does not attract s.138 unless the sum is a legally enforceable debt at maturity.",
